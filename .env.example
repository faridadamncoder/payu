# Database. SQLite untuk development; untuk production pakai PostgreSQL
# (ubah provider di prisma/schema.prisma menjadi "postgresql").
DATABASE_URL="file:./dev.db"

# URL publik aplikasi (dipakai untuk link di pesan WhatsApp & metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Folder penyimpanan file upload (foto produk, bukti bayar). Default: ./storage
UPLOAD_DIR="./storage"

# Pembayaran langganan Payu (ditampilkan di halaman Langganan dashboard).
# Kosongkan jika belum siap menerima pembayaran.
PLATFORM_QRIS_PAYLOAD=""
PLATFORM_BANK_NAME=""
PLATFORM_BANK_ACCOUNT=""
PLATFORM_BANK_HOLDER=""
PLATFORM_WHATSAPP=""
